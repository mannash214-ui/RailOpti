# Server Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/optirail?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_32_chars_long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Client Configuration (Optional if deployed separately)
VITE_API_URL=/api
